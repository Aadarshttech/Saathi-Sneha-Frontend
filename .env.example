# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sahayata_db"

# ── Stripe (card payments — https://dashboard.stripe.com/test/apikeys) ────────
# Secret key — never expose this in the browser
STRIPE_SECRET_KEY="sk_test_..."
# Publishable key — safe to expose in the browser (used for Stripe.js if needed)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret — from Stripe Dashboard → Developers → Webhooks
# Register endpoint: POST /api/billing/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Khalti (Nepal phone pay — https://test-admin.khalti.com) ──────────────────
# Secret key — never expose this in the browser
KHALTI_SECRET_KEY="test_secret_key_..."

# ── Resend (contact form emails — https://resend.com/api-keys) ────────────────
RESEND_API_KEY="re_..."
# Verified sender address in your Resend domain; falls back to onboarding@resend.dev if unset
RESEND_FROM_EMAIL="Saathi Sneha Care <notifications@saathisnehacare.com>"

# ── App ───────────────────────────────────────────────────────────────────────
# Full public URL of this deployment (no trailing slash)
NEXT_PUBLIC_APP_URL="https://saathisnehacare.com"

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production — 32+ random bytes, used to sign all session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-hex-chars-of-random-bytes"

# Admin portal credentials — no defaults; app refuses login if unset
ADMIN_USERNAME="your-admin-username"
ADMIN_PASSWORD="your-strong-admin-password"

# Organisation UUID — set after first seed run
NEXT_PUBLIC_ORG_ID="your-org-uuid-from-db"
