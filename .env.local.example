# Database — AWS RDS PostgreSQL (Mumbai)
DATABASE_URL="postgresql://sahayata_user:password@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/sahayata_db"

# Set after running: npm run db:seed
NEXT_PUBLIC_ORG_ID="<org-uuid-from-seed>"

# Optional: NextAuth or JWT secret for auth (future)
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"
